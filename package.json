{
	"name": "singmaker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 4380",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.functions.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"sprites": "node scripts/process-sprites.mjs",
		"validate": "npm run check && npm run lint && npm run test && npm run build",
		"logo": "node scripts/process-logo.mjs"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^16.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.66.0",
		"vite": "^6.3.5",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"sharp@0.35.5": true
	}
}
